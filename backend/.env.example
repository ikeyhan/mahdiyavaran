# پیکربندی بک‌اند اتم — این فایل را به .env کپی کنید
# پورت سرور
PORT=3000

# کلید امضای توکن JWT — حتماً در محیط واقعی یک مقدار تصادفی و بلند بگذارید
# می‌توانید با دستور زیر یک کلید امن بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# مدت اعتبار توکن ورود
JWT_EXPIRES=8h

# اطلاعات مدیر اولیه (فقط بار اول هنگام ساخت دیتابیس استفاده می‌شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=atom313@

# مبدأهای مجاز CORS (با کاما جدا کنید) — خالی یعنی فقط same-origin
CORS_ORIGINS=
