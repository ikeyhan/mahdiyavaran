# پیکربندی بک‌اند اتم — این فایل را به .env کپی کنید
# پورت سرور
PORT=3000

# کلید امضای توکن JWT — اگر خالی بماند، سرور یک کلید تصادفی امن می‌سازد و در data/jwt-secret نگه می‌دارد
# می‌توانید با دستور زیر یک کلید امن بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# مدت اعتبار توکن ورود
JWT_EXPIRES=8h

# اطلاعات مدیر اولیه (فقط بار اول هنگام ساخت دیتابیس استفاده می‌شود)
ADMIN_USERNAME=admin
# حتماً پیش از اولین اجرا روی سرور واقعی، رمز قوی بگذارید
ADMIN_PASSWORD=atom313@

# ساخت حساب‌ها و داده‌های نمونه (فروشنده atra، دفتر daftar، …) — برای راه‌اندازی واقعی 0 بگذارید
SEED_DEMO=1

# مبدأهای مجاز CORS (با کاما جدا کنید) — خالی یعنی فقط same-origin
CORS_ORIGINS=
